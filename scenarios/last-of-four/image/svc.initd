#!/bin/sh
### BEGIN INIT INFO
# Provides:          dns-cluster-services
# Required-Start:    $local_fs $network
# Required-Stop:     $local_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: one init script for the daemons of this host; the service is chosen by the script name
### END INIT INFO
PATH=/usr/sbin:/usr/bin:/sbin:/bin
NAME=$(basename "$0")
case "$NAME" in
  # a resolver replica: unbound in the foreground, it drops to its own user after binding port 53
  dns-ns[1-4]) R=${NAME#dns-}; RUNAS=root; CMD="/usr/sbin/unbound -d -c /etc/dns-cluster/$R/unbound.conf"; LOG=/var/log/$NAME/unbound.log ;;
  # the outside world of the stand; binds port 53 and drops to nobody
  extdns)      RUNAS=root;     CMD="/usr/bin/python3 /opt/extdns/extdns.py";      LOG=/var/log/extdns/queries.log ;;
  issuer)      RUNAS=issuer;   CMD="/usr/bin/python3 /opt/issuer/issuer.py";      LOG=/var/log/issuer/issuer.log ;;
  mon-agent)   RUNAS=monagent; CMD="/usr/bin/python3 /opt/mon-agent/mon_agent.py"; LOG=/var/log/mon-agent/agent.log ;;
  *) echo "unknown service: $NAME" >&2; exit 2 ;;
esac
PIDFILE=/run/$NAME.pid

. /lib/lsb/init-functions

start() {
  log_daemon_msg "Starting $NAME"
  start-stop-daemon --start --quiet --oknodo --background --make-pidfile --pidfile "$PIDFILE" \
    --chuid "$RUNAS" --no-close --startas /bin/sh -- -c "exec $CMD" >>"$LOG" 2>&1
  log_end_msg $?
}
stop() {
  log_daemon_msg "Stopping $NAME"
  start-stop-daemon --stop --quiet --oknodo --retry=TERM/5/KILL/2 --pidfile "$PIDFILE"
  rc=$?; rm -f "$PIDFILE"; log_end_msg $rc
}
case "${1:-}" in
  start) start ;;
  stop) stop ;;
  restart|reload|force-reload) stop; sleep 1; start ;;
  status) status_of_proc -p "$PIDFILE" "$NAME" "$NAME" ;;
  *) echo "Usage: service $NAME {start|stop|restart|status}"; exit 2 ;;
esac
