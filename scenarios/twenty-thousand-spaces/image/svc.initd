#!/bin/sh
### BEGIN INIT INFO
# Provides:          forum-services
# Required-Start:    $local_fs $network
# Required-Stop:     $local_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: one init script for the daemons of this host; the service is chosen by the script name
### END INIT INFO
PATH=/usr/sbin:/usr/bin:/sbin:/bin
NAME=$(basename "$0")
CFG=/etc/haproxy/haproxy.cfg
case "$NAME" in
  forum-web1) RUNAS=forum;  CMD="env INSTANCE=web1 PORT=8001 /usr/bin/python3 /opt/forum/app.py"; LOG=/var/log/forum/web1.log ;;
  forum-web2) RUNAS=forum;  CMD="env INSTANCE=web2 PORT=8002 /usr/bin/python3 /opt/forum/app.py"; LOG=/var/log/forum/web2.log ;;
  haproxy)    RUNAS=root;   CMD="/usr/sbin/haproxy -W -db -f $CFG";                               LOG=/var/log/haproxy/haproxy.log ;;
  trafficgen) RUNAS=nobody; CMD="/usr/bin/python3 /opt/trafficgen/trafficgen.py";                 LOG=/dev/null ;;
  *) echo "unknown service: $NAME" >&2; exit 2 ;;
esac
PIDFILE=/run/$NAME.pid

. /lib/lsb/init-functions

start() {
  log_daemon_msg "Starting $NAME"
  if [ "$NAME" = haproxy ]; then
    mkdir -p /run/haproxy
    /usr/sbin/haproxy -c -q -f "$CFG" || { log_end_msg 1; return 1; }
  fi
  start-stop-daemon --start --quiet --oknodo --background --make-pidfile --pidfile "$PIDFILE" \
    --chuid "$RUNAS" --no-close --startas /bin/sh -- -c "exec $CMD" >>"$LOG" 2>&1
  log_end_msg $?
}
stop() {
  log_daemon_msg "Stopping $NAME"
  start-stop-daemon --stop --quiet --oknodo --retry=TERM/5/KILL/2 --pidfile "$PIDFILE"
  rc=$?; rm -f "$PIDFILE"; log_end_msg $rc
}
reload() {
  if [ "$NAME" != haproxy ]; then stop; sleep 1; start; return; fi
  log_daemon_msg "Reloading $NAME"
  /usr/sbin/haproxy -c -q -f "$CFG" || { log_end_msg 1; return 1; }
  # master-worker mode: USR2 makes the master re-read the configuration and start new workers
  kill -USR2 "$(cat "$PIDFILE" 2>/dev/null)" 2>/dev/null
  log_end_msg $?
}
case "${1:-}" in
  start) start ;;
  stop) stop ;;
  restart) stop; sleep 1; start ;;
  reload|force-reload) reload ;;
  status) status_of_proc -p "$PIDFILE" "$NAME" "$NAME" ;;
  *) echo "Usage: service $NAME {start|stop|restart|reload|status}"; exit 2 ;;
esac
