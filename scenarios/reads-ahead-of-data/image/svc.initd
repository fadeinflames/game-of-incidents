#!/bin/sh
### BEGIN INIT INFO
# Provides:          auth-services
# Required-Start:    $local_fs $network
# Required-Stop:     $local_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: one init script for the daemons of this host; the service is chosen by the script name
### END INIT INFO
PATH=/usr/sbin:/usr/bin:/sbin:/bin
NAME=$(basename "$0")
STOP_RETRY=TERM/5/KILL/2
RELOAD=no
case "$NAME" in
  # the databases run in the foreground under this script: the packaged init script needs a writable root file system
  db-old|db-new) RUNAS=mysql;      CMD="/usr/sbin/mariadbd --defaults-file=/etc/mysql/$NAME.cnf";    LOG=/var/log/$NAME/error.log; STOP_RETRY=TERM/30/KILL/5 ;;
  tokend)        RUNAS=tokend;     CMD="/usr/bin/python3 -u /opt/tokend/tokend.py";                  LOG=/var/log/tokend/api.log; RELOAD=yes ;;
  tablemover)    RUNAS=tablemover; CMD="/usr/bin/python3 -u /opt/tablemover/tablemover.py daemon";   LOG=/var/log/tablemover/tablemover.log ;;
  loadgen)       RUNAS=nobody;     CMD="/usr/bin/python3 -u /opt/loadgen/loadgen.py";                LOG=/dev/null ;;
  *) echo "unknown service: $NAME" >&2; exit 2 ;;
esac
PIDFILE=/run/$NAME.pid

. /lib/lsb/init-functions

start() {
  log_daemon_msg "Starting $NAME"
  [ "$LOG" = /dev/null ] || { touch "$LOG" && chown "$RUNAS" "$LOG"; }
  start-stop-daemon --start --quiet --oknodo --background --make-pidfile --pidfile "$PIDFILE" \
    --chuid "$RUNAS" --no-close --startas /bin/sh -- -c "exec $CMD" >>"$LOG" 2>&1
  log_end_msg $?
}
stop() {
  log_daemon_msg "Stopping $NAME"
  start-stop-daemon --stop --quiet --oknodo --retry=$STOP_RETRY --pidfile "$PIDFILE"
  rc=$?; rm -f "$PIDFILE"; log_end_msg $rc
}
reload() {
  [ "$RELOAD" = yes ] || { echo "$NAME has no reload, use restart" >&2; exit 3; }
  log_daemon_msg "Reloading $NAME"
  start-stop-daemon --stop --signal HUP --quiet --pidfile "$PIDFILE"
  log_end_msg $?
}
case "${1:-}" in
  start) start ;;
  stop) stop ;;
  restart) stop; sleep 1; start ;;
  reload|force-reload) reload ;;
  status) status_of_proc -p "$PIDFILE" "$NAME" "$NAME" ;;
  *) echo "Usage: service $NAME {start|stop|restart|reload|status}"; exit 2 ;;
esac
