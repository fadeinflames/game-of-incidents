# db-old: the old shared database cluster (on this stand: one MariaDB instance, port 3306)
[mariadbd]
user = mysql
datadir = /var/lib/db-old
socket = /run/mysqld/db-old.sock
pid-file = /run/mysqld/db-old.pid
bind-address = 127.0.0.1
port = 3306
skip-name-resolve
skip-log-bin
character-set-server = utf8mb4
performance_schema = OFF
innodb_buffer_pool_size = 32M
innodb_log_file_size = 16M
innodb_log_buffer_size = 2M
innodb_flush_log_at_trx_commit = 2
max_connections = 40
thread_cache_size = 4
table_open_cache = 64
key_buffer_size = 1M
aria_pagecache_buffer_size = 1M
query_cache_size = 0
tmp_table_size = 4M
max_heap_table_size = 4M
