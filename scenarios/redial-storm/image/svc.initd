#!/bin/sh
### BEGIN INIT INFO
# Provides:          pipeline-services
# Required-Start:    $local_fs $network
# Required-Stop:     $local_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: one init script for the daemons of this host; the service is chosen by the script name
### END INIT INFO
PATH=/usr/sbin:/usr/bin:/sbin:/bin
NAME=$(basename "$0")
GWCFG=/etc/haproxy/haproxy.cfg
case "$NAME" in
  seg-gw)       RUNAS=root;      CMD="/usr/sbin/haproxy -W -db -f $GWCFG";                             LOG=/var/log/seg-gw/haproxy.log ;;
  queue-redis)  RUNAS=redis;     CMD="/usr/bin/redis-server /etc/redis/queue-redis.conf";              LOG=/var/log/queue-redis/redis.log ;;
  notify-redis) RUNAS=redis;     CMD="/usr/bin/redis-server /etc/redis/notify-redis.conf";             LOG=/var/log/notify-redis/redis.log ;;
  scheduler)    RUNAS=scheduler; CMD="/usr/bin/python3 /opt/scheduler/scheduler.py";                   LOG=/var/log/scheduler/scheduler.log ;;
  notifier)     RUNAS=notifier;  CMD="/usr/bin/python3 /opt/notifier/notifier.py";                     LOG=/var/log/notifier/notifier.log ;;
  runner-[1-8]) RUNAS=runner;    CMD="env RUNNER_NAME=$NAME /usr/bin/python3 /opt/runner/runner.py";   LOG=/var/log/$NAME/runner.log ;;
  *) echo "unknown service: $NAME" >&2; exit 2 ;;
esac
PIDFILE=/run/$NAME.pid

. /lib/lsb/init-functions

start() {
  log_daemon_msg "Starting $NAME"
  if [ "$NAME" = seg-gw ]; then
    mkdir -p /run/haproxy
    /usr/sbin/haproxy -c -q -f "$GWCFG" || { log_end_msg 1; return 1; }
  fi
  touch "$LOG" && chown "$RUNAS" "$LOG"
  start-stop-daemon --start --quiet --oknodo --background --make-pidfile --pidfile "$PIDFILE" \
    --chuid "$RUNAS" --no-close --startas /bin/sh -- -c "exec $CMD" >>"$LOG" 2>&1
  log_end_msg $?
}
stop() {
  log_daemon_msg "Stopping $NAME"
  start-stop-daemon --stop --quiet --oknodo --retry=TERM/5/KILL/2 --pidfile "$PIDFILE"
  rc=$?; rm -f "$PIDFILE"; log_end_msg $rc
}
reload() {
  case "$NAME" in
    runner-[1-8])
      log_daemon_msg "Reloading $NAME"
      # SIGHUP: the runner re-reads /etc/runner/runner.conf and keeps its connections
      kill -HUP "$(cat "$PIDFILE" 2>/dev/null)" 2>/dev/null
      log_end_msg $? ;;
    *) echo "$NAME has no reload: use restart" >&2; return 3 ;;
  esac
}
case "${1:-}" in
  start) start ;;
  stop) stop ;;
  restart) stop; sleep 1; start ;;
  reload|force-reload) reload ;;
  status) status_of_proc -p "$PIDFILE" "$NAME" "$NAME" ;;
  *) echo "Usage: service $NAME {start|stop|restart|reload|status}"; exit 2 ;;
esac
