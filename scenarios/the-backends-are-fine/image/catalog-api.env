# catalog-api settings. Apply with: service catalog-api reload (re-reads this file, keeps connections and the cache)
LISTEN=127.0.0.1:8080

# entitlements service of the billing team, reached through its gateway
ENTITLEMENTS_URL=http://127.0.0.1:9000
ENTITLEMENT_LOOKUP_TIMEOUT_SEC=2.5
# for how many seconds the answer of the entitlements service is reused for the same account
ENTITLEMENT_CACHE_TTL_SEC=2

# translation engines: name=address
ENGINES=std=http://127.0.0.1:9201,pro=http://127.0.0.1:9202
