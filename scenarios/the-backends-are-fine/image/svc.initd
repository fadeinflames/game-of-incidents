#!/bin/sh
### BEGIN INIT INFO
# Provides:          translate-services
# Required-Start:    $local_fs $network
# Required-Stop:     $local_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: one init script for the daemons of this host; the service is chosen by the script name
### END INIT INFO
PATH=/usr/sbin:/usr/bin:/sbin:/bin
NAME=$(basename "$0")
case "$NAME" in
  catalog-api)  RUNAS=catalog; CMD="/usr/bin/python3 /opt/catalog-api/catalog_api.py /etc/catalog-api/catalog-api.env"; LOG=/var/log/catalog-api/catalog-api.log ;;
  entitlements) RUNAS=billing; CMD="/usr/bin/python3 /opt/entitlements/entitlements.py";                                LOG=/var/log/entitlements/entitlements.log ;;
  engine-std)   RUNAS=engine;  CMD="env ENGINE=std PORT=9201 /usr/bin/python3 /opt/engine/engine.py";                   LOG=/var/log/engine-std/engine.log ;;
  engine-pro)   RUNAS=engine;  CMD="env ENGINE=pro PORT=9202 /usr/bin/python3 /opt/engine/engine.py";                   LOG=/var/log/engine-pro/engine.log ;;
  loadgen)      RUNAS=nobody;  CMD="/usr/bin/python3 /opt/loadgen/loadgen.py";                                          LOG=/dev/null ;;
  *) echo "unknown service: $NAME" >&2; exit 2 ;;
esac
PIDFILE=/run/$NAME.pid

. /lib/lsb/init-functions

start() {
  log_daemon_msg "Starting $NAME"
  start-stop-daemon --start --quiet --oknodo --background --make-pidfile --pidfile "$PIDFILE" \
    --chuid "$RUNAS" --no-close --startas /bin/sh -- -c "exec $CMD" >>"$LOG" 2>&1
  log_end_msg $?
}
stop() {
  log_daemon_msg "Stopping $NAME"
  start-stop-daemon --stop --quiet --oknodo --retry=TERM/5/KILL/2 --pidfile "$PIDFILE"
  rc=$?; rm -f "$PIDFILE"; log_end_msg $rc
}
reload() {
  if [ "$NAME" != catalog-api ]; then
    echo "$NAME has no reload: use restart" >&2
    return 3
  fi
  log_daemon_msg "Reloading $NAME"
  # SIGHUP: the process re-reads its settings file and keeps its connections and its cache
  kill -HUP "$(cat "$PIDFILE" 2>/dev/null)" 2>/dev/null
  log_end_msg $?
}
case "${1:-}" in
  start) start ;;
  stop) stop ;;
  restart) stop; sleep 1; start ;;
  reload|force-reload) reload ;;
  status) status_of_proc -p "$PIDFILE" "$NAME" "$NAME" ;;
  *) echo "Usage: service $NAME {start|stop|restart|reload|status}"; exit 2 ;;
esac
